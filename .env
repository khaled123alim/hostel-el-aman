# Environment variables — copy to `.env` and fill in. See .env.example for details.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SESSION_HOURS="168"

# SMTP (optional — emails are logged to console when not configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="StayHub <noreply@example.com>"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional — payment gateway disabled until keys are added)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Map provider: "osm" (no key) | "mapbox" | "google"
MAP_PROVIDER="osm"
MAPBOX_TOKEN=""
GOOGLE_MAPS_KEY=""

# Admin bootstrap login (used by seed)
SEED_ADMIN_EMAIL="admin@stayhub.com"
SEED_ADMIN_PASSWORD="Admin@12345"